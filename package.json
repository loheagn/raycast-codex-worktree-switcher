{
  "name": "codex-worktree-switcher",
  "title": "Codex Worktree Switcher",
  "description": "Switch Codex Desktop and your preferred editor to the selected local session",
  "icon": "icon.png",
  "author": "loheagn",
  "license": "MIT",
  "private": true,
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loheagn/raycast-codex-worktree-switcher.git"
  },
  "bugs": {
    "url": "https://github.com/loheagn/raycast-codex-worktree-switcher/issues"
  },
  "homepage": "https://github.com/loheagn/raycast-codex-worktree-switcher#readme",
  "keywords": [
    "raycast-extension",
    "codex",
    "zed",
    "vscode",
    "git-worktree",
    "macos"
  ],
  "categories": [
    "Developer Tools",
    "Productivity"
  ],
  "platforms": [
    "macOS"
  ],
  "commands": [
    {
      "name": "switch-codex-worktree",
      "title": "Switch Codex Worktree",
      "subtitle": "Codex Worktree Switcher",
      "description": "Open a Codex session and its Git checkout in your preferred editor",
      "mode": "view",
      "icon": "icon.png",
      "keywords": [
        "codex",
        "zed",
        "vscode",
        "worktree",
        "session",
        "conversation",
        "会话",
        "切换"
      ]
    }
  ],
  "preferences": [
    {
      "name": "codexHome",
      "title": "Codex Home",
      "description": "Directory containing Codex Desktop metadata.",
      "type": "directory",
      "default": "~/.codex",
      "required": true
    },
    {
      "name": "defaultEditor",
      "title": "Default Editor",
      "description": "Editor used by the open actions.",
      "type": "dropdown",
      "default": "zed",
      "required": false,
      "data": [
        {
          "title": "Zed",
          "value": "zed"
        },
        {
          "title": "Visual Studio Code",
          "value": "vscode"
        },
        {
          "title": "Visual Studio Code Insiders",
          "value": "vscode-insiders"
        }
      ]
    },
    {
      "name": "zedApp",
      "title": "Zed App",
      "description": "Zed application to use when opening a worktree.",
      "type": "appPicker",
      "default": "dev.zed.Zed",
      "required": false
    },
    {
      "name": "vscodeApp",
      "title": "VS Code App",
      "description": "Visual Studio Code application to use when opening a worktree.",
      "type": "appPicker",
      "default": "com.microsoft.VSCode",
      "required": false
    },
    {
      "name": "vscodeInsidersApp",
      "title": "VS Code Insiders App",
      "description": "Visual Studio Code Insiders application to use when opening a worktree.",
      "type": "appPicker",
      "default": "com.microsoft.VSCodeInsiders",
      "required": false
    }
  ],
  "scripts": {
    "build": "ray build",
    "check": "npm test && npm run typecheck && npm run lint && npm run format:check && npm run build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "ray lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@raycast/api": "1.104.22",
    "@raycast/utils": "2.3.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.1.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.18",
    "eslint": "^9.22.0",
    "prettier": "^3.9.6",
    "typescript": "^5.8.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "packageManager": "npm@10.9.7"
}
